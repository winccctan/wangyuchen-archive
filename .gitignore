node_modules/
scraper/.env
scraper/cron.log

# 系统文件
.DS_Store

# 数据备份（重解析前快照，体积大，不入库）
site/data/*.bak

# 项目级 agent 记忆（不入库）
scraper/.workbuddy/

# 补档断点游标（本机状态，不入库）
